{
  "name": "copperpot-delivery-adapter",
  "version": "0.1.0",
  "description": "Menu and order sync between the Copperpot Bowls commerce API and third-party delivery partners.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"contracts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"contracts/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run --dir src",
    "test:contract": "vitest run --dir contracts",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "fastify": "^4.26.2",
    "pino": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.11.30",
    "eslint": "^9.12.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.2"
  }
}
